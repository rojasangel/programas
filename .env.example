# Copia este archivo como .env y configura los valores antes de publicar.
APP_ENV=production
# Genera un secreto aleatorio de al menos 32 caracteres y guárdalo solo en el entorno del servidor.
SECRET_KEY=pon-aqui-una-clave-aleatoria-de-al-menos-32-caracteres
WHATSAPP_NUMBER=526861234567
SHOP_EMAIL=ventas@tudominio.com
CUSTOM_BAT_ORDER_ALERT_EMAILS=correo1@ejemplo.com,correo2@ejemplo.com
ADMIN_USERNAME=Javiersin
ADMIN_PASSWORD=cambia-esta-contrasena
GOOGLE_CLIENT_ID=tu-cliente-web.apps.googleusercontent.com
# Correo para confirmaciones automáticas (Gmail: usa una contraseña de aplicación).
EMAIL_NOTIFICATIONS=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ventas@tudominio.com
SMTP_PASSWORD=contraseña-de-aplicación
SMTP_FROM=ventas@tudominio.com
EMAIL_REPLY_TO=ventas@tudominio.com
# Stripe Checkout (usa claves de prueba mientras desarrollas).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_BASE_URL=http://127.0.0.1:5000
BUSINESS_LEGAL_NAME=
BUSINESS_RFC=
BUSINESS_PHYSICAL_ADDRESS=
SHIPPING_ESTIMATE=180
# Skydropx (las credenciales se quedan solo en el servidor; no las pongas en plantillas ni JavaScript).
SKYDROPX_API_BASE=https://api-pro.skydropx.com
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
SKYDROPX_ORIGIN_COUNTRY=MX
SKYDROPX_ORIGIN_POSTAL_CODE=
SKYDROPX_ORIGIN_STATE=Baja California
SKYDROPX_ORIGIN_CITY=Mexicali
SKYDROPX_ORIGIN_NEIGHBORHOOD=
SKYDROPX_ORIGIN_ADDRESS=
# Opcional: limita las paqueterías que se cotizan, separadas por comas (ej. fedex,dhl).
SKYDROPX_REQUESTED_CARRIERS=
FLASK_DEBUG=0

